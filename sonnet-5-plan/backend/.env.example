DATABASE_URL=postgresql://docportal:changeme@localhost:5432/docportal
NODE_ENV=development
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_HOURS=1

# Leave blank in dev to log reset links to the console instead of sending email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@docportal.local
