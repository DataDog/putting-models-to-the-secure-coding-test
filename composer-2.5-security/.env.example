# Backend
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5432/document_portal

# Auth secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-hex-string
SESSION_SECRET=change-me-to-another-random-64-char-hex-string

# Frontend URL (for CORS and password-reset links)
CLIENT_URL=http://localhost:5173

# Email (optional — reset links are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@document-portal.local

# Frontend build-time API URL (used by GitHub Pages deploy)
VITE_API_URL=http://localhost:3001/api
