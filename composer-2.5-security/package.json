{
  "name": "document-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Document portal with authentication, file upload, search, and comments",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "scfw run npm install",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "dev": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend"
  },
  "engines": {
    "node": ">=18"
  }
}
