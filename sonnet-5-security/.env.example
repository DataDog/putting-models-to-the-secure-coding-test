# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection used by docker-compose and the backend
POSTGRES_USER=document_portal
POSTGRES_PASSWORD=
POSTGRES_DB=document_portal
DATABASE_URL=postgres://document_portal:CHANGE_ME@localhost:5432/document_portal

# Backend
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Auth secrets - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SIGNING_SECRET=

# Frontend (build-time)
VITE_API_URL=http://localhost:4000
