# Server
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://portal:portal@localhost:5432/document_portal
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# SMTP (optional in dev — reset links logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Client (Vite)
VITE_API_URL=http://localhost:3000

# GitHub Pages build
GITHUB_PAGES_BASE=/
API_URL=https://api.example.com
