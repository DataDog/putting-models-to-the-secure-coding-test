# Copy to server/.env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=3000

# postgresql://user:password@host:5432/document_portal
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_portal

# Origin of the frontend, used for CORS. No trailing slash.
CLIENT_ORIGIN=http://localhost:5500

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-hex-string
COOKIE_SECRET=replace-with-a-different-random-64-char-hex-string

# Optional SMTP config for password-reset emails. If unset, reset links are
# logged to the server console instead — fine for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Document Portal <no-reply@example.com>"

# Directory (outside any public/static path) where uploaded files are stored.
UPLOAD_DIR=./uploads
